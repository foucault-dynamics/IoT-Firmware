# PlatformIO build output, including the whole ESP-IDF build tree
.pio/

# ESP-IDF build output, if a firmware is ever built with idf.py directly
build/

# Components fetched from the ESP Component Registry by the IDF component
# manager. The sources are downloadable, so they stay out of the repo, but
# `dependencies.lock` next to them is committed: it pins the exact versions.
managed_components/

# Generated from sdkconfig.defaults on each build; do not commit the generated
# ones. PlatformIO writes `sdkconfig.<env>`, idf.py writes `sdkconfig`.
sdkconfig.meter_node
sdkconfig.substation
sdkconfig.gateway
sdkconfig
sdkconfig.old

# Editor and tooling
.vscode/
.cache/
compile_commands.json
