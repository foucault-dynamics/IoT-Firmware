CONFIG_IDF_TARGET="esp32"

# 1 ms scheduler tick: the LoRa poll loop and ACK guard are in milliseconds.
CONFIG_FREERTOS_HZ=1000

# The gateway holds WiFi, MQTT and LoRa at once; the default 1M app partition is
# tight. Matches the table PlatformIO is pinned to in platformio.ini.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
